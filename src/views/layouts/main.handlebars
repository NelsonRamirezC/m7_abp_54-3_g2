<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}} | Nexo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/app.css">
</head>
<body data-page="{{active}}">
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <a class="brand" href="/"><span class="brand-mark">N</span><span>Nexo<span class="brand-dot">.</span></span></a>
            <p class="sidebar-label">Operación</p>
            <nav class="nav flex-column gap-1">
                <a class="nav-link {{#if (eq active 'dashboard')}}active{{/if}}" href="/"><span>⌂</span> Resumen</a>
                <a class="nav-link {{#if (eq active 'sales')}}active{{/if}}" href="/ventas"><span>↗</span> Ventas</a>
                <a class="nav-link {{#if (eq active 'products')}}active{{/if}}" href="/productos"><span>□</span> Productos</a>
                <a class="nav-link {{#if (eq active 'categories')}}active{{/if}}" href="/categorias"><span>▦</span> Categorías</a>
                <a class="nav-link {{#if (eq active 'users')}}active{{/if}}" href="/usuarios"><span>♙</span> Usuarios</a>
                <a class="nav-link {{#if (eq active 'profiles')}}active{{/if}}" href="/perfiles"><span>◉</span> Perfiles</a>
            </nav>
            <div class="sidebar-note mt-auto"><small>API conectada</small><strong>localhost:3000</strong><span class="status-dot"></span></div>
        </aside>
        <main class="main-content">
            <header class="topbar"><button class="menu-button d-lg-none" id="menuButton" type="button">☰</button><span class="eyebrow">Panel de gestión</span><span class="topbar-date" id="today"></span></header>
            <section class="page-content">{{{body}}}</section>
        </main>
    </div>
    <div id="toast" class="toast-message" role="status"></div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/app.js"></script>
</body>
</html>