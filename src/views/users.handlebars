<div class="page-heading"><div><p class="eyebrow accent">Personas</p><h1
        >Usuarios</h1><p class="subtitle">Consulta y administra las cuentas
            registradas.</p></div><button
        class="btn btn-dark"
        data-bs-toggle="modal"
        data-bs-target="#userModal"
    >+ Nuevo usuario</button></div>
<div class="data-panel"><div class="panel-toolbar"><h2>Directorio</h2><input
            class="form-control search-input"
            data-filter="#usersTable"
            placeholder="Buscar usuario..."
            type="search"
        /></div><div class="table-responsive"><table
            class="table align-middle"
            id="usersTable"
        ><thead><tr><th>Usuario</th><th>RUT</th><th>Correo</th><th
                    >Username</th><th></th></tr></thead><tbody
                id="usersRows"
            ><tr><td colspan="5" class="loading">Cargando usuarios...</td></tr></tbody></table></div></div>
<div class="modal fade" id="userModal" tabindex="-1"><div
        class="modal-dialog modal-dialog-centered"
    ><div class="modal-content"><div class="modal-header"><h2>Nuevo usuario</h2><button
                    class="btn-close"
                    data-bs-dismiss="modal"
                ></button></div><form id="userForm"><div
                    class="modal-body row g-3"
                ><div class="col-md-6"><label>Nombre<input
                                name="firstName"
                                class="form-control"
                                required
                            /></label></div><div class="col-md-6"><label
                        >Apellido<input
                                name="lastName"
                                class="form-control"
                                required
                            /></label></div><div class="col-md-6"><label
                        >RUT<input
                                name="rut"
                                class="form-control"
                                placeholder="12.345.678-9"
                                required
                            /></label></div><div class="col-md-6"><label
                        >Correo<input
                                name="email"
                                type="email"
                                class="form-control"
                                required
                            /></label></div><div class="col-md-6"><label
                        >Username<input
                                name="username"
                                class="form-control"
                                required
                            /></label></div><div class="col-md-6"><label
                        >Contraseña<input
                                name="password"
                                type="password"
                                class="form-control"
                                required
                            /></label></div></div><div
                    class="modal-footer"
                ><button
                        type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal"
                    >Cancelar</button><button class="btn btn-dark">Crear usuario</button></div></form></div></div></div>